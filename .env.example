# Copy this file to .env.local (git-ignored) to turn on live Claude reviews.
# Without DECIDRA_AI=live, "Challenge my top 3" uses a free rule-based mock
# and never calls the API.
DECIDRA_AI=live

# Your Anthropic API key, from https://platform.claude.com. It stays in the
# dev server process and is never sent to the browser. Leave it empty to use
# an `ant auth login` profile instead.
ANTHROPIC_API_KEY=
